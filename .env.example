# 密钥配置（可选）——把本文件复制成 .env 即可生效，不用改系统环境变量
# 优先级：页面「设置」里填的 > 系统环境变量 > 这个文件
# 说明：proxy.js 里**没有**内置默认密钥（内置密钥会随源码泄露），所以要在这里或「设置」页填。
#       改完这个文件不用重启：代理每次请求都会重读它（热加载）。

# SparkCine（生图 / 视频）
SPARKCINE_API_KEY=sc_live_你的密钥

# VGENV（视频）
VGENV_API_KEY=vgenv_live_你的密钥

# DeepSeek 文字 AI（提示词润色、分镜切片规划、AI 检索）
DEEPSEEK_API_KEY=sk-你的密钥

# MiMo 语音合成（语音工作台 / 音色复刻）
MIMO_API_KEY=sk-你的密钥

# 数据落盘目录（默认项目目录下的 .data/）——工作区、设置、历史都会同步写一份到这里
# 想放到云盘同步目录（OneDrive / 坚果云等）就填绝对路径，例如：
# DATA_DIR=D:\OneDrive\sparkcine-data
DATA_DIR=

# 提示词归档目录（默认项目目录下的 prompts/）——每次创建任务把提示词存一份 md 在这里
# 也可以不写在这里，改到「设置 → 提示词归档」里填（那样只存在本机浏览器）
# PROMPTS_DIR=D:\我的提示词
PROMPTS_DIR=

# 云同步（WebDAV）：坚果云 / Nextcloud / 群晖 都支持
# 也可以不写在这里，改到「设置 → 数据与同步」里填（那样只存在本机浏览器）
# 坚果云请在「账户信息 → 安全选项」里生成「应用密码」，不要用登录密码
CLOUD_WEBDAV_URL=
CLOUD_WEBDAV_USER=
CLOUD_WEBDAV_PASS=
